# Only explicitly listed publication files may be added to Git.
/*
!/.gitignore
!/README.md
!/requirements.txt
!/textbook.pdf
!/notebook/
/notebook/*
!/notebook/complete/
!/notebook/student/
/notebook/complete/*
!/notebook/complete/chap00_complete.ipynb
!/notebook/complete/chap01_complete.ipynb
!/notebook/complete/chap02_complete.ipynb
!/notebook/complete/chap03_complete.ipynb
!/notebook/complete/chap04_complete.ipynb
!/notebook/complete/chap05_complete.ipynb
!/notebook/complete/chap06_complete.ipynb
!/notebook/complete/chap07_complete.ipynb
/notebook/student/*
!/notebook/student/chap00_student.ipynb
!/notebook/student/chap01_student.ipynb
!/notebook/student/chap02_student.ipynb
!/notebook/student/chap03_student.ipynb
!/notebook/student/chap04_student.ipynb
!/notebook/student/chap05_student.ipynb
!/notebook/student/chap06_student.ipynb
!/notebook/student/chap07_student.ipynb
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/validate.yml
